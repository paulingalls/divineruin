#!/usr/bin/env bash
set -e

# Block .env files from being committed. The whole family, not just the bare name:
# sprint-047 staged a .env.bak-<stamp> sidecar that this guard, anchored on `.env$`,
# waved through. .env.example is the one tracked member.
# --diff-filter=d so REMOVING a leaked .env is not itself blocked.
staged_env=$(git diff --cached --name-only --diff-filter=d | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$staged_env" ]; then
  echo "ERROR: .env file detected in staging area: $staged_env"
  exit 1
fi

# The constraints wall. SessionStart renders the lead's regions into a 9500-byte
# budget and clips constraints.md's tail, so a file over the cap is not "a bit long" —
# it is rules the lead never reads. Before the node_modules early-exit: this needs
# python3 and two files, so it holds in a fresh teammate worktree too.
# The pre-push self-test runs this hook inside a scratch repo that has no .xp/ at all.
# A tree with NEITHER file is not an xp checkout, so there is nothing to measure; a tree
# with one and not the other is a misconfiguration and refuses below, either way round.
# scripts/test-precommit-worktree-skip.sh pins all four of those trees.
if [ -f .xp/constraints.md ] || [ -f .xp/config.yml ]; then
  cap="$(sed -n 's/^constraints_chars_cap:[[:space:]]*//p' .xp/config.yml 2>/dev/null | head -1 | sed 's/[^0-9].*$//')"
  if [ -z "$cap" ]; then
    echo "ERROR: constraints_chars_cap missing from .xp/config.yml — refusing to pass a commit nothing measured." >&2
    exit 1
  fi
  if [ ! -f .xp/constraints.md ]; then
    echo "ERROR: .xp/config.yml declares a $cap-byte cap but .xp/constraints.md is missing — refusing to pass a commit nothing measured." >&2
    exit 1
  fi
  size=$(python3 -c "import pathlib,sys; sys.stdout.write(str(len(pathlib.Path('.xp/constraints.md').read_bytes())))")
  if [ "$size" -gt "$cap" ]; then
    echo "ERROR: .xp/constraints.md is $size bytes, over its $cap-byte cap." >&2
    echo "  SessionStart clips the tail at its 9500-byte budget. Shorten a rule or retire one;" >&2
    echo "  the evidence behind a rule belongs in .xp/system.md (Constraint case law)." >&2
    exit 1
  fi
fi

# The lint suite below (bun/tsc/eslint/prettier + the uv-driven ruff script) needs installed deps.
# A fresh git worktree — a teammate checkout — has no node_modules, which previously forced
# `git commit --no-verify`. Skip the suite there with a clear notice instead: the main-checkout hook
# runs the full suite, and the pre-push gate (run from a deps-installed checkout) re-runs the full
# typecheck + tests, so nothing reaches a shared branch unchecked.
if [ ! -d node_modules ]; then
  echo "  [pre-commit] node_modules absent (fresh worktree) — skipping TS/ESLint/Prettier/ruff lint suite."
  echo "  [pre-commit] Full coverage is provided by the main-checkout hook and the pre-push gate."
  exit 0
fi

echo "Running pre-commit lint checks..."

# One script, shared with pre-push and CI, so the three gates cannot drift apart.
#
# `lint:e2e` is NOT in this lane: it installs e2e's separate dep tree (e2e is not
# a workspace member), which on a checkout that has never run it means a full
# network install mid-commit. pre-push and CI carry it. e2e *formatting* is
# covered here — `lint:ts`'s prettier glob includes e2e/.
bun run lint

echo "All lint checks passed."
