#!/usr/bin/env bash
set -e

# Block .env files from being committed. The whole family, not just the bare name:
# sprint-047 staged a .env.bak-<stamp> sidecar that this guard, anchored on `.env$`,
# waved through. .env.example is the one tracked member.
# --diff-filter=d so REMOVING a leaked .env is not itself blocked.
staged_env=$(git diff --cached --name-only --diff-filter=d | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$staged_env" ]; then
  echo "ERROR: .env file detected in staging area: $staged_env"
  exit 1
fi

# Secret scan of the staged index. It sits above the node_modules skip so a fresh
# worktree is scanned too, and it refuses when gitleaks is missing.
. "$(dirname "$0")/hook-lib.sh"
secrets_scan_index

# The staged language checks below need installed deps.
# A fresh worktree has no node_modules. The pre-push gate checks full lint and
# typechecks before code reaches a shared branch.
if [ ! -d node_modules ]; then
  echo "  [pre-commit] node_modules absent (fresh worktree) — skipping staged language checks."
  echo "  [pre-commit] Full lint is provided by the pre-push gate and CI."
  exit 0
fi

echo "Running staged language checks..."
bash scripts/test-fast.sh
