#!/usr/bin/env bash
set -e

# Git exports repository-local variables to hooks. Clear them so fixture repos
# created by the test lanes do not write into the checkout being pushed.
while IFS= read -r git_var; do unset "$git_var"; done \
  < <(git rev-parse --local-env-vars)

PREPUSH_TEST_MODE=production
if [ "${1:-}" = __prepush_harness__ ] && [ "${2:-}" = __prepush_harness__ ]; then
  case "${3:-}" in
    docs|lanes) PREPUSH_TEST_MODE="$3" ;;
  esac
fi
FULL_TIER=false
if [ "${1:-}" = __xp_full_tier__ ] && [ "$#" -eq 1 ]; then FULL_TIER=true; fi
if [ "$PREPUSH_TEST_MODE" = docs ] && [ "${4:-}" = full ]; then FULL_TIER=true; fi

if [ "$PREPUSH_TEST_MODE" = production ]; then
  for name in BASH_TEST BASH_TEST_DIFF BASH_TEST_MASK_ENV BASH_TEST_LINT_FAIL PREPUSH_LANE_DRIVER PREPUSH_TEST_ENV_SOURCE PREPUSH_ART_DIR PREPUSH_E2E_DIR; do
    value="${!name-}"
    if [ -n "$value" ]; then
      echo "ERROR: production pre-push refuses internal test override $name." >&2
      exit 1
    fi
  done
fi

# Env vars to strip from unit tests so missing mocks are caught locally.
# CI's test-bun job has DATABASE_URL + REDIS_URL (real services) but NOT
# these external API vars — so we match that here.
EXTERNAL_API_VARS=(
  LIVEKIT_URL LIVEKIT_API_KEY LIVEKIT_API_SECRET
  ANTHROPIC_API_KEY DEEPGRAM_API_KEY
  INWORLD_API_KEY INWORLD_WORKSPACE_ID
)

mask_external_api_environment() {
  for var in "${EXTERNAL_API_VARS[@]}"; do export "$var="; done
}

mask_python_test_environment() {
  mask_external_api_environment
  export DATABASE_URL= REDIS_URL=
}

if [ "$PREPUSH_TEST_MODE" = docs ] && [ -n "${BASH_TEST_MASK_ENV:-}" ]; then
  mask_python_test_environment
  exec bun --env-file="$BASH_TEST_MASK_ENV" -e '
    const names = ["DATABASE_URL", "REDIS_URL", "LIVEKIT_URL", "LIVEKIT_API_KEY", "LIVEKIT_API_SECRET", "ANTHROPIC_API_KEY", "DEEPGRAM_API_KEY", "INWORLD_API_KEY", "INWORLD_WORKSPACE_ID"];
    if (names.some((name) => Bun.env[name] !== "")) process.exit(1);
  '
fi

# The positional docs mode stubs the git diff source and heavy test runner.
if [ "$PREPUSH_TEST_MODE" = docs ]; then
  _get_diff() {
    [ "${BASH_TEST_DIFF:-}" != __FAIL__ ] || return 1
    while IFS= read -r path; do
      [ -z "$path" ] && continue
      if [[ "$path" == *$'\t'* ]]; then printf '%s\n' "$path"; else printf 'M\t%s\n' "$path"; fi
    done <<< "${BASH_TEST_DIFF:-}"
  }
  _run_lint_only() {
    echo "LINT_ONLY"
    [ "${BASH_TEST_LINT_FAIL:-}" != 1 ]
  }
  _run_tests() { echo "TESTS_RAN"; }
else
  _get_diff() { git -c diff.renames=true diff --name-status --no-ext-diff "$1" "$2"; }
  _run_lint_only() {
    echo "  Full lint + typecheck for work branch..."
    bun run lint
    bun run lint:e2e
  }
  _run_tests() {
    echo "Running pre-push test suite..."

    # The positional lane mode replaces the lanes and their preamble together.
    if [ "$PREPUSH_TEST_MODE" != lanes ]; then
    # Validate the hook's own docs-only-skip logic before relying on it.
    # The harness uses positional docs mode in sub-shells, so it cannot recurse here.
    echo "  Pre-push hook self-test..."
    bash "$(dirname "$0")/test-pre-push.sh"

    # Validate the pre-commit hook's worktree-skip + .env-guard precedence.
    echo "  Pre-commit hook self-test..."
    bash "$(dirname "$0")/../scripts/test-precommit-worktree-skip.sh"
    echo "  Fast-tier selector self-test..."
    bash "$(dirname "$0")/../scripts/test-fast-tier.sh"

    # Validate the per-worktree host-port-offset derivation (worktree-common.sh).
    echo "  Worktree bootstrap offset self-test..."
    bash "$(dirname "$0")/../scripts/test-init-worktree.sh"

    # Typecheck + lint backstop. Pre-commit checks staged files and skips language
    # tools in fresh worktrees without deps. Fast-fail here (set -e),
    # BEFORE standing up the Docker/testcontainer lanes below — a typo shouldn't cost minutes.
    echo "  Lint + typecheck (root, mobile, server, web, python)..."
    bun run lint
    # e2e/ typechecks HERE and in CI, but not in pre-commit — see that hook for why.
    echo "  Lint + typecheck (e2e)..."
    bun run lint:e2e

    # Acceptance tests require Docker — hard gate (no silent skip on pre-push).
    echo "  Acceptance prerequisite: Docker..."
    if ! docker info >/dev/null 2>&1; then
      echo "ERROR: Docker must be running for pre-push acceptance tests." >&2
      exit 1
    fi

    # Both stand up real Compose stacks, so they sit BELOW the Docker gate (a
    # Docker-less host gets the message above, not a raw compose error) and
    # below the lint backstop, which is what keeps a typo cheap.
    echo "  Worktree ownership self-test..."
    bash "$(dirname "$0")/../scripts/test-worktree-ownership.sh"
    echo "  Worktree listener ownership self-test..."
    bash "$(dirname "$0")/../scripts/test-worktree-listener-ownership.sh"

    # Reap orphaned per-run test containers from earlier runs that were SIGKILL'd
    # (or SIGTERM'd before teardown finished) so they don't accumulate. PID-aware:
    # a live concurrent run's containers are skipped, never killed.
    bash "$(dirname "$0")/../scripts/sweep-test-containers.sh" || true
    fi

    # Provision Postgres + Redis for the lanes that need real services (E2E's API
    # server). No-op when DATABASE_URL is already set, so a dev with .env / CI's
    # service vars is unaffected; otherwise it stands up a per-run docker pg+redis on
    # ephemeral ports + migrates + seeds and exports DATABASE_URL/REDIS_URL. Lets the
    # gate run without a sourced .env, and isolates the DB across overlapping runs.
    # Most server bun tests are env-independent, but the test:server lane
    # below runs db.test.ts against the live DB — keep DATABASE_URL exported here
    # or that lazy-Proxy regression test silently skips. (The acceptance and
    # Python lanes unset these below: their pytest lifecycle resolves and
    # validates THIS checkout's own stack, which a per-run ephemeral endpoint
    # is not and is refused as foreign.)
    # Combined cleanup: kill every STILL-RUNNING backgrounded lane AND remove the
    # per-run test-env containers via _te_teardown (defined by test-env.sh).
    # bg_pids tracks only un-reaped jobs (reaped PIDs are dropped below so the
    # trap never kills a recycled PID). Initialised + trap registered BEFORE
    # sourcing so a failure mid-provision still tears down; _te_teardown guard
    # tolerates it not existing yet. INT/TERM too so a killed push doesn't leak.
    bg_pids=()
    _terminate_lane_tree() {
      local parent="$1" child
      for child in $(pgrep -P "$parent" 2>/dev/null); do
        _terminate_lane_tree "$child"
      done
      kill "$parent" 2>/dev/null || true
    }
    _cleanup() {
      for pid in "${bg_pids[@]}"; do _terminate_lane_tree "$pid"; done
      for pid in "${bg_pids[@]}"; do wait "$pid" 2>/dev/null || true; done
      command -v _te_teardown >/dev/null 2>&1 && _te_teardown || true
    }
    trap _cleanup EXIT INT TERM

    # shellcheck source=scripts/test-env.sh
    if [ "$PREPUSH_TEST_MODE" = lanes ]; then
      source "$PREPUSH_TEST_ENV_SOURCE"
    else
      source "$(dirname "$0")/../scripts/test-env.sh"
    fi
    # shellcheck source=scripts/lane-utils.sh
    source "$(dirname "$0")/../scripts/lane-utils.sh"

    # One durable home for EVERY lane's logs (gitignored). Each lane tees its
    # combined stdout/stderr to flake-artifacts/last-<lane>.log; on a lane failure
    # those logs are snapshotted into a timestamped subdir that survives the next
    # gate run (the last-*.log files are overwritten each run). This is the single
    # place to look when the gate flakes — the e2e lane already proved the pattern;
    # the acceptance + unit lanes (where the sprint-027 testcontainer transient hit)
    # had no capture at all before this.
    ART="${PREPUSH_ART_DIR:-$(cd "$(dirname "$0")/.." && pwd)/flake-artifacts}"
    mkdir -p "$ART"
    snap_dir() { printf '%s/%s-%s' "$ART" "$(date +%Y%m%d-%H%M%S)" "$(git rev-parse --short HEAD)"; }

    # Run acceptance in the background so it overlaps the unit + E2E steps. Tee to a
    # durable log; `set -o pipefail` so the subshell's exit is pytest's real code,
    # not tee's (~always 0) — otherwise `wait $acc_pid` below would never see a
    # failure through the pipe.
    # REQUIRE_REAL_LLM=1: the real-LLM scenarios must fail loud here, never skip
    # (story-019 AC1). test:acceptance sets it too — the gate is not the only caller.
    # The per-run services belong to server/E2E. Acceptance reloads this checkout's
    # owned settings and provider credentials through test:acceptance's env file.
    ( set -o pipefail; unset DATABASE_URL REDIS_URL; \
      REQUIRE_DOCKER=1 REQUIRE_REAL_LLM=1 TESTCONTAINERS_RYUK_DISABLED=true \
      run_pre_push_lane acceptance bun run test:acceptance 2>&1 | tee "$ART/last-acceptance.log" ) &
    acc_pid=$!
    bg_pids+=("$acc_pid")

    # The Bun/Python unit lanes are independent — server's db.test.ts uses
    # the provisioned DB, python unsets DB/REDIS and resolves this checkout's own
    # stack from .env, mobile/shared are env-light — so run them CONCURRENTLY,
    # each in its own env subshell so var scoping can't leak across siblings. Wall-clock drops from
    # sum-of-lanes to max-lane; wait_all_lanes fails the push loud if ANY lane
    # exits non-zero (never swallows an exit code).
    echo "  Bun + Python unit lanes (parallel: scripts, server, mobile, web, shared, design tokens, e2e environment, python)..."
    unit_specs=()
    # Each lane tees to flake-artifacts/last-<lane>.log; `set -o pipefail` keeps the
    # subshell's exit the lane's real code (not tee's) so wait_all_lanes still sees
    # failures through the pipe.
    # server: test:server isolates db.test.ts (real lazy SQL Proxy) in its own
    # process; keep DATABASE_URL or it silently skips. Strip only the external API
    # vars (matches CI's test-bun env).
    ( set -o pipefail; mask_external_api_environment; \
      run_pre_push_lane server bun run test:server 2>&1 | tee "$ART/last-server.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:server")
    ( set -o pipefail; run_pre_push_lane mobile bun test --cwd apps/mobile 2>&1 | tee "$ART/last-mobile.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:mobile")
    ( set -o pipefail; run_pre_push_lane shared bun test --cwd packages/shared 2>&1 | tee "$ART/last-shared.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:shared")
    ( set -o pipefail; run_pre_push_lane scripts bun --env-file=.env test ./scripts 2>&1 | tee "$ART/last-scripts.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:scripts")
    ( set -o pipefail; run_pre_push_lane design-tokens bun test --cwd packages/design-tokens 2>&1 | tee "$ART/last-design-tokens.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:design-tokens")
    ( set -o pipefail; run_pre_push_lane web bun test --cwd apps/web 2>&1 | tee "$ART/last-web.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:web")
    ( set -o pipefail; run_pre_push_lane e2e-environment bun test e2e/require-environment.test.ts 2>&1 | tee "$ART/last-e2e-environment.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:e2e-environment")
    # Empty values prevent explicit env files from restoring unit-test credentials.
    ( set -o pipefail; mask_python_test_environment; \
      run_pre_push_lane python bun run test:python 2>&1 | tee "$ART/last-python.log" ) &
    p=$!; bg_pids+=("$p"); unit_specs+=("$p:python")

    # `if` context suppresses set -e so a failing lane is captured, not aborted-on.
    if wait_all_lanes "${unit_specs[@]}"; then unit_rc=0; else unit_rc=$?; fi
    bg_pids=("$acc_pid")  # unit lanes reaped — drop them from the trap's kill list
    if [ "$unit_rc" -ne 0 ]; then
      snap="$(snap_dir)"
      snapshot_lane_logs "$snap" \
        "$ART/last-server.log" "$ART/last-mobile.log" "$ART/last-shared.log" "$ART/last-scripts.log" \
        "$ART/last-design-tokens.log" "$ART/last-web.log" "$ART/last-e2e-environment.log" "$ART/last-python.log"
      echo "ERROR: one or more unit lanes failed. Logs preserved at:" >&2
      echo "    $snap" >&2
      exit 1
    fi

    # E2E tests — run locally with Playwright (fast: ~80s) AFTER the unit barrier:
    # it needs the per-run DB, boots its own API/Expo/web servers, and is
    # resource-heavy. reuseExistingServer:false means an overlapping run fails
    # loud on a port conflict rather than silently collapsing onto a shared
    # (cross-killed) server.
    echo "  E2E tests (local Playwright)..."
    # Tee combined stdout/stderr (incl. the API server's [diag]/logError lines)
    # to a durable log, and on failure snapshot it + Playwright's retain-on-
    # failure artifacts (trace/video/screenshot in test-results/) into a
    # timestamped, gitignored dir that SURVIVES the retry — test-results/ is
    # wiped by the next `playwright test` run, so without this the evidence from
    # a flake is gone before anyone looks. The pipeline's own exit is tee's (~always
    # 0), so `set -e` won't abort before we read PIPESTATUS[0] — Playwright's REAL
    # exit code (NOT tee's). Capturing PIPESTATUS[0] must be the statement
    # immediately after the pipeline (any other command clobbers PIPESTATUS).
    e2e_dir="${PREPUSH_E2E_DIR:-$(cd "$(dirname "$0")/../e2e" && pwd)}"
    e2e_log="$ART/last-e2e.log"
    (cd "$e2e_dir" && run_pre_push_lane e2e bunx playwright test --reporter=list) 2>&1 | tee "$e2e_log"
    e2e_rc=${PIPESTATUS[0]}
    if [ "$e2e_rc" -ne 0 ]; then
      snap="$(snap_dir)"
      snapshot_lane_logs "$snap" "$e2e_log"
      cp -R "$e2e_dir/test-results" "$snap/test-results" 2>/dev/null || true
      echo "ERROR: E2E tests failed. Artifacts preserved at:" >&2
      echo "    $snap" >&2
      echo "  Inspect a trace with: bunx playwright show-trace $snap/test-results/<test-dir>/trace.zip" >&2
      exit 1
    fi

    # Propagate the backgrounded acceptance result. Reap + clear bg_pids BEFORE
    # the failure exit (same pattern as the unit barrier) so the trap never kills
    # the just-reaped acceptance PID.
    echo "  Acceptance tests (waiting)..."
    if wait "$acc_pid"; then acc_rc=0; else acc_rc=$?; fi
    bg_pids=()  # acceptance reaped — trap now only tears down the test-env containers
    if [ "$acc_rc" -ne 0 ]; then
      snap="$(snap_dir)"
      snapshot_lane_logs "$snap" "$ART/last-acceptance.log"
      # Capture container state + the LiveKit acceptance container's logs — the
      # actual surface of the sprint-027 startup transient. Best-effort (|| true):
      # this is environmental evidence and must never fail the gate on top of the
      # acceptance failure it documents. The per-run Postgres testcontainer is
      # session-scoped and usually torn down by the time we get here, so the
      # docker-ps snapshot is what records whether it ever came up.
      docker ps -a > "$snap/docker-ps.log" 2>&1 || true
      docker logs divineruin-livekit-acceptance > "$snap/livekit-container.log" 2>&1 || true
      echo "ERROR: acceptance tests failed. Logs preserved at:" >&2
      echo "    $snap" >&2
      exit 1
    fi

    if [ "$PREPUSH_TEST_MODE" = lanes ]; then
      echo "Internal pre-push lane harness passed."
    else
      echo "All tests passed."
    fi
  }
fi

if [ "$FULL_TIER" = true ]; then
  _run_tests
  exit 0
fi

work_ref() {
  case "$1" in
    refs/heads/story-*|refs/heads/sprint-*|refs/heads/free-*|refs/heads/paulingalls/story-*|refs/heads/paulingalls/sprint-*|refs/heads/paulingalls/free-*) return 0 ;;
    *) return 1 ;;
  esac
}

work_path() {
  case "$1" in
    *.md|docs/*|.claude/*|memory/*) return 0 ;;
    # Story Verify runs focused acceptance; the sprint full tier runs the whole lane.
    # A work-branch push should not repeat that lane for a test or recorded fixture edit.
    apps/agent/tests/acceptance/*) return 0 ;;
    apps/agent/*.py|apps/agent/tests/*.py|apps/server/src/*.ts|apps/server/src/*.tsx|apps/mobile/src/*.ts|apps/mobile/src/*.tsx|apps/web/src/*.ts|apps/web/src/*.tsx|packages/shared/src/*.ts|packages/design-tokens/src/*.ts|content/*.json) return 0 ;;
    *) return 1 ;;
  esac
}

# --- Pushed-ref routing ---
# Read pushed-ref list from stdin (pre-push hook protocol: one line per ref
# as `local_ref local_sha remote_ref remote_sha`) and skip the test suite
# when every changed file matches a docs-only pattern. Any error → fall
# through to the full suite (fail-safe).
ZERO_SHA="0000000000000000000000000000000000000000"
DOCS_ONLY=true
WORK_ONLY=true
CHANGED=""
SAW_REF=false        # any non-empty refspec line seen
ALL_DELETIONS=true   # every seen ref is a deletion (local_sha = ZERO)
REF_COUNT=0
TAG_PUSH=false
RELEASE_TAG=""
RELEASE_OBJECT=""

while read -r local_ref local_sha remote_ref remote_sha; do
  # A blank read (empty stdin yields one) is not a pushed ref — don't count it.
  if [ -z "${local_ref:-}${local_sha:-}${remote_ref:-}${remote_sha:-}" ]; then
    continue
  fi
  SAW_REF=true
  REF_COUNT=$((REF_COUNT + 1))
  if [ -z "${local_ref:-}" ] || [ -z "${local_sha:-}" ] || [ -z "${remote_ref:-}" ] || [ -z "${remote_sha:-}" ]; then
    ALL_DELETIONS=false
    DOCS_ONLY=false
    WORK_ONLY=false
    break
  fi
  if [ "${local_sha}" = "${ZERO_SHA}" ]; then
    continue  # branch deletion — keeps ALL_DELETIONS true
  fi
  ALL_DELETIONS=false  # a real (non-deletion) ref
  if [[ "$remote_ref" == refs/tags/* ]]; then
    TAG_PUSH=true
    if [[ "$remote_ref" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$remote_sha" = "$ZERO_SHA" ]; then
      RELEASE_TAG="${remote_ref#refs/tags/}"
      RELEASE_OBJECT="$local_sha"
    fi
    continue
  fi
  if ! work_ref "$remote_ref"; then WORK_ONLY=false; fi
  if [ "${remote_sha:-}" = "${ZERO_SHA}" ] || [ -z "${remote_sha:-}" ]; then
    # New branch: diff against the merge-base with origin/main.
    if ! BASE=$(git merge-base "${local_sha}" origin/main 2>/dev/null); then
      DOCS_ONLY=false
      WORK_ONLY=false
      break
    fi
  else
    BASE="${remote_sha}"
  fi
  if ! REF_CHANGED=$(_get_diff "${BASE}" "${local_sha}"); then
    DOCS_ONLY=false
    WORK_ONLY=false
    break
  fi
  while IFS=$'\t' read -r status source target; do
    [ -z "$status" ] && continue
    if [ -z "$source" ]; then DOCS_ONLY=false; WORK_ONLY=false; break; fi
    case "$status" in
      R*|C*)
        if [ -z "$target" ]; then DOCS_ONLY=false; WORK_ONLY=false; break; fi
        CHANGED="${CHANGED}${CHANGED:+$'\n'}${source}"$'\n'"${target}" ;;
      A|M|D|T)
        if [ -n "$target" ]; then DOCS_ONLY=false; WORK_ONLY=false; break; fi
        CHANGED="${CHANGED}${CHANGED:+$'\n'}${source}" ;;
      *) DOCS_ONLY=false; WORK_ONLY=false; break ;;
    esac
  done <<< "$REF_CHANGED"
done

# Pure branch-deletion push (every ref is a deletion) → nothing to test. Skip
# before the docs/code evaluation so deleting a remote branch doesn't run the
# full gate (previously required --no-verify).
if [ "$SAW_REF" = true ] && [ "$ALL_DELETIONS" = true ]; then
  echo "Branch-deletion push — skipping test suites."
  exit 0
fi

# A new vMAJOR.MINOR.PATCH tag adds no source — its commit already merged through
# main, where the full tier ran. Ancestry of origin/main proves that; the root
# manifest pins the tag to the tree it names.
if [ "$TAG_PUSH" = true ]; then
  DOCS_ONLY=false
  WORK_ONLY=false
  if [ "$REF_COUNT" -eq 1 ] && [ -n "$RELEASE_TAG" ]; then
    if peeled=$(git rev-parse --verify "${RELEASE_OBJECT}^{commit}" 2>/dev/null) \
      && git merge-base --is-ancestor "$peeled" origin/main 2>/dev/null \
      && manifest_version=$(git show "${peeled}:package.json" 2>/dev/null | bun -e '
        const parsed = JSON.parse(await Bun.stdin.text());
        if (typeof parsed.version !== "string") process.exit(1);
        process.stdout.write(parsed.version);
      ' 2>/dev/null) \
      && [ "$manifest_version" = "${RELEASE_TAG#v}" ]; then
      echo "Verified release tag $RELEASE_TAG at $peeled — skipping test suites."
      exit 0
    fi
  fi
fi

# Empty stdin (no refs to consider) → run tests (safe fallback).
if [ -z "$CHANGED" ]; then
  DOCS_ONLY=false
  WORK_ONLY=false
fi

if [ "$DOCS_ONLY" = true ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      *.md|docs/*|.claude/*|memory/*) ;;
      *) DOCS_ONLY=false; break ;;
    esac
  done <<< "$CHANGED"
fi

if [ "$DOCS_ONLY" = true ]; then
  echo "Docs-only push — skipping test suites."
  exit 0
fi

if [ "$WORK_ONLY" = true ]; then
  while IFS= read -r path; do
    if ! work_path "$path"; then WORK_ONLY=false; break; fi
  done <<< "$CHANGED"
fi

if [ "$WORK_ONLY" = true ]; then
  echo "XP work-branch source push — running lint/typecheck only."
  _run_lint_only
  exit 0
fi

_run_tests
