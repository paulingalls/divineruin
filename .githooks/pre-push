#!/usr/bin/env bash
set -e

# Git's checkout variables would redirect fixture repositories into this tree.
while IFS= read -r git_var; do unset "$git_var"; done \
  < <(git rev-parse --local-env-vars)

. "$(dirname "$0")/hook-lib.sh"
secrets_scan_push "${1:-}"

bun run lint
bun run lint:e2e
bun --env-file=.env test ./scripts --path-ignore-patterns='**/test_content.test.ts'
bun test --cwd apps/mobile
bun test --cwd apps/web
bun test --cwd packages/shared
bun test --cwd packages/design-tokens
bun test e2e/ports.test.ts e2e/require-environment.test.ts

(
  # Empty exports prevent the explicit env file from restoring credentials.
  export LIVEKIT_URL= LIVEKIT_API_KEY= LIVEKIT_API_SECRET= ANTHROPIC_API_KEY= DEEPGRAM_API_KEY=
  export INWORLD_API_KEY= INWORLD_WORKSPACE_ID= DATABASE_URL= REDIS_URL=
  bun --env-file=../../.env test --cwd apps/server --path-ignore-patterns='**/{db,locations-load.integration,invite-store}.test.ts'
)
