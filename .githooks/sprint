#!/usr/bin/env bash
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# Empty exports prevent explicit env files from restoring paid approval.
export ALLOW_PAID_TESTS= REQUIRE_REAL_LLM=

if ! docker info >/dev/null 2>&1; then
  echo "ERROR: Docker must be running for sprint tests." >&2
  exit 1
fi
bash scripts/sweep-test-containers.sh || true

ART="$PWD/flake-artifacts"
mkdir -p "$ART" || exit 1
# Providers own endpoints; the E2E runner preserves browser artifacts before sandbox removal.
unset DATABASE_URL REDIS_URL
REQUIRE_DOCKER=1 TESTCONTAINERS_RYUK_DISABLED=true \
  bunx proof run --set sprint 2>&1 | tee "$ART/last-sprint.log"
status=${PIPESTATUS[0]}
if [ "$status" -ne 0 ]; then
  snap="$ART/$(date +%Y%m%d-%H%M%S)-$(git rev-parse --short HEAD)"
  mkdir -p "$snap" && {
    cp "$ART/last-sprint.log" "$snap/" || true
    docker ps -a > "$snap/docker-ps.log" 2>&1 || true
  }
  echo "ERROR: sprint tests failed. Logs preserved at: $snap" >&2
  exit "$status"
fi
echo "All tests passed."
