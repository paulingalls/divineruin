# Development/test switches: leave unset in production.
# server: test-runner isolation, development-only; default unset; refused in production (forces mock email).
# BUN_TEST=
# server: development diagnostics, optional; default off.
# E2E_DIAG=
# server: development debug console, ignored in production; default off.
# ENABLE_DEBUG_CONSOLE=
# server: development-only bypass; 1 is forbidden in production; default off.
# RATE_LIMIT_BYPASS=
# Trust exactly one proxy that appends the client address; keep the server port loopback-only.
TRUSTED_PROXY_HOPS=1

# Separate mobile build (not consumed by the four Compose services).
# mobile: required public HTTPS API URL in production builds; development derives local host.
# EXPO_PUBLIC_API_URL=
