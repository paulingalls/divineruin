# Production operator template: copy outside version control and fill every active assignment.
# Services: migrate (schema + seed), server (HTTP), agent (voice), worker (background).
# Blank active assignments are required inputs. Optional defaults stay commented: empty is not unset.

# Shared dependencies
# migrate/server/agent/worker: required; no default.
DATABASE_URL=
# migrate/server/agent/worker: required; no default.
REDIS_URL=
# migrate/agent/worker: optional shared content-cache prefix; default empty.
# CONTENT_CACHE_PREFIX=
# server/agent/worker: required shared secret; no production default.
INTERNAL_SECRET=
# server/agent: required managed LiveKit endpoint and credentials; no default.
LIVEKIT_URL=
# server/agent: required; no default.
LIVEKIT_API_KEY=
# server/agent: required; no default.
LIVEKIT_API_SECRET=
# agent/worker: required background provider, including with openai-luna gameplay; no default.
ANTHROPIC_API_KEY=
# agent: required for default openai-luna gameplay; optional when GAMEPLAY_LLM=anthropic; no default.
OPENAI_API_KEY=
# agent: required speech recognition; no default.
DEEPGRAM_API_KEY=
# agent/worker: required TTS; no default.
INWORLD_API_KEY=

# Server
# server: required signing secret; no production default.
JWT_SECRET=
# server: required allowed origin (or * for mobile-only); no production default.
CORS_ORIGIN=
# server: required portrait provider key; no default.
GEMINI_API_KEY=
# server: required email provider key; no default. Verify sender domain before first sign-in.
RESEND_API_KEY=
# server: optional sender; default auth@divineruin.com.
# RESEND_FROM_EMAIL=
# server: optional transport; defaults to resend with key outside tests. mock is forbidden in production.
# EMAIL_TRANSPORT=
# server: optional bind port; default 3001, keep for Compose port mapping.
# PORT=
# server: optional bind address; default 0.0.0.0, keep for container reachability.
# SERVER_HOST=

# Compose / image settings: supplied automatically; do not fill these in the env file.
# server: image start command sets production; host default development.
# NODE_ENV=
# agent/worker: Compose sets production; host default development.
# AGENT_ENV=
# server/agent/worker: Compose sets /var/lib/divineruin/media; local default assets/generated.
# MEDIA_DIR=
# agent/worker: Compose sets http://server:3001; host default http://localhost:3001.
# SERVER_URL=
# migrate: Compose sets 1 for production seed safety; default unset.
# SEED_PRODUCTION=

# Optional agent/worker settings
# agent: optional gameplay provider; default openai-luna, alternative anthropic.
# GAMEPLAY_LLM=
# agent/worker: optional TTS endpoint; default https://api.inworld.ai.
# INWORLD_BASE_URL=

# Voices: configure distinct Inworld voice IDs; no code defaults.
# agent/worker: narrator voice needed for speech; no voice ID default.
INWORLD_VOICE_DM=
# agent/worker: optional authored voice; default empty warns and uses narrator. Fill for character identity.
# INWORLD_VOICE_TORIN=
